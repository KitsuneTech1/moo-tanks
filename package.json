{
  "name": "moo-tanks",
  "private": true,
  "description": "A Diep-style browser tank arena prototype with bots.",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "typecheck": "tsc",
    "sim:smoke": "node scripts/sim-smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "backend:check": "cargo check --manifest-path backend/spacetimedb/Cargo.toml",
    "build": "tsc && vite build --configLoader native",
    "preview": "vite preview --configLoader native"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
